# 로컬: `npx supabase start` 또는 `npx supabase status` 출력값을 복사
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 고객 공유 링크에 쓰이는 사이트 주소
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 사진 저장소 (S3 호환)
# 로컬: `npx supabase status`의 S3_PROTOCOL_* 값 사용
# 운영(R2): S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com, S3_REGION=auto
S3_ENDPOINT=http://127.0.0.1:54321/storage/v1/s3
S3_REGION=local
S3_BUCKET=photos
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# 서버 전용 관리자 키 (로컬: `npx supabase status`의 SECRET_KEY)
SUPABASE_SECRET_KEY=
