# 로컬: `npx supabase start` 또는 `npx supabase status` 출력값을 복사
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 고객 공유 링크에 쓰이는 사이트 주소
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 사진 저장소 (S3 호환)
# 로컬: `npx supabase status`의 S3_PROTOCOL_* 값 사용
# 운영(R2): S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com, S3_REGION=auto
S3_ENDPOINT=http://127.0.0.1:54321/storage/v1/s3
S3_REGION=local
S3_BUCKET=photos
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# 서버 전용 관리자 키 (로컬: `npx supabase status`의 SECRET_KEY)
SUPABASE_SECRET_KEY=

# 고객 갤러리 접근 쿠키 서명용. 생성: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
GALLERY_ACCESS_SECRET=

# 작가 결제 키(토스 시크릿) 암호화용 32바이트 키. 바꾸면 저장된 키를 다시 입력해야 함
PAYMENT_SECRET_KEY=

# 알림 메일. RESEND_API_KEY가 있으면 Resend, 없으면 MAILPIT_URL(로컬)로 보낸다.
EMAIL_FROM=noreply@selectgallery.test
RESEND_API_KEY=
MAILPIT_URL=http://127.0.0.1:54324

# 만료 처리 cron 호출 인증. Vercel 환경 변수에 같은 값을 넣으면 Vercel Cron이 자동으로 붙여 호출한다.
CRON_SECRET=
